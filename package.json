{
  "name": "polymine",
  "private": true,
  "version": "0.0.2",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bindings": "cargo test -p polymine --test bindings",
    "notices": "node scripts/notices.mjs",
    "coverage": "vitest run --coverage",
    "coverage:rust": "cargo llvm-cov --workspace --html --output-dir coverage/rust",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#target\" \"#scripts/notices\" \"#.claude/worktrees\" \"#docs/local\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.9",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "~2.10.2",
    "pixi.js": "^8.22.0"
  }
}
